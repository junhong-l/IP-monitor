#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_BINARY="${TRIM_APPDEST}/server/email-notify"
SERVICE_PORT="${TRIM_SERVICE_PORT:-8543}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

start_process() {
    if status; then
        return 0
    fi

    mkdir -p "${TRIM_PKGVAR}"
    if [ ! -x "${APP_BINARY}" ]; then
        echo "未找到可执行文件：${APP_BINARY}" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: executable not found or not executable: ${APP_BINARY}"
        return 1
    fi

    log_msg "Starting ${APP_BINARY} on port ${SERVICE_PORT}"
    (
        cd "${TRIM_APPDEST}/server" || exit 1
        exec "${APP_BINARY}" -port "${SERVICE_PORT}" -data-dir "${TRIM_PKGVAR}"
    ) >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"

    sleep 1
    if ! status; then
        echo "应用启动失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: process exited immediately"
        rm -f "${PID_FILE}"
        return 1
    fi
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"
        
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "Process not running, remove pid file"
            return 0
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}" 2>/dev/null || true
            sleep 1
        fi
        
        rm -f "${PID_FILE}"
        log_msg "Process stopped, pid file removed."
    else
        log_msg "No pid file found, nothing to stop."
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case "$1" in
start)
    start_process
    exit $?
    ;;
stop)
    stop_process
    ;;
status)
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
